{{ $authedExists := false }}
{{ $unauthedExists := false }}
{{ range . }}
    {{ $auth := .Spec.Security }}
    {{ if $auth }}
        {{ $authedExists = true }}
    {{ else if not $auth }}
        {{ $unauthedExists = true }}
    {{ end -}}
