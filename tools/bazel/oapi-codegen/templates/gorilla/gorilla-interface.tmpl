// ServerInterface represents all server handlers.
type ServerInterface interface {
{{- range .}}{{$opid := .OperationId}}
// {{$opid}} ({{.Method}} {{.Path}})
{{ .SummaryAsComment }}
{{- $isRawHandler := (index .Spec.Extensions "x-multiplay-raw-handler") -}}
{{- if $isRawHandler }}
    {{$opid}}(w http.ResponseWriter, r *http.Request)
{{ else }}
    {{- $ret := "[]byte" -}}
    {{- $method := .Method | lower }}
    {{- if (eq $method "delete") }}
        {{- $ret = "*pkghttp.ResourceDelete" -}}
    {{- end }}
    {{- if .GetResponseTypeDefinitions }}
        {{- $t := index .GetResponseTypeDefinitions 0 -}}
            {{- if or (eq $t.TypeName "JSON200") (eq $t.TypeName "JSON201") (eq $t.TypeName "JSON202") (eq $t.TypeName "JSON204") }}{{ $ret = ($t.Schema.GoType | printf "*%s") }}{{ end -}}
        {{- end }}
        {{- $form := "" -}}
        {{- if or (eq $method "post") (eq $method "put") (eq $method "patch") }}
            {{- if and (eq (len .Bodies) 0) (.Spec.RequestBody) }}
                {{- $c := index .Spec.RequestBody.Value.Content "multipart/form-data" -}}
                {{- if $c }}{{ $form = ", multipartForm map[string][]string" }}{{ end -}}
            {{- end }}
        {{- end }}
        {{- $hasContentRange := false }}
        {{- range $k, $v := .Spec.Responses.Map -}}
            {{- range $header, $unused := $v.Value.Headers }}
                {{- if eq $header "Content-Range" }}{{ $hasContentRange = true }}{{ end -}}
            {{- end }}
        {{- end }}
        {{$opid}}(ctx context.Context, l *slog.Logger, r *http.Request{{genParamArgs .PathParams}}{{if .RequiresParamObject}}, params {{$opid}}Params{{end}}{{range $i, $b := .Bodies}}, body{{$i}} *{{$opid}}JSONBody{{end}}{{$form}}) ({{ $ret }}, {{ if $hasContentRange }}*pkghttp.ContentRange,{{ end }} error)
    {{ end }}
{{ end }}
}
